{
    "compilerOptions": {
      "target": "ES2022",
      "module": "Node16",
      "moduleResolution": "Node16",
      "outDir": "./build",
      "rootDir": "./src",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "isolatedModules": true
    },
    "include": ["src/**/*"],
    "exclude": [
      "node_modules", 
      "build", 
      "tests", 
      "src/tests/**/*",
      "**/*.test.ts",
      "**/*.spec.ts",
      "src/services/core/server/legacy/**"
    ]
  }